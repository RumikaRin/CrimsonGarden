# ============================================================
# CRIMSON ACADEMY — Environment Variables
# Copy file này thành .env và điền thông tin thực tế
# ============================================================

# --- Neon PostgreSQL Connection (REQUIRED for DB features) ---
# Lấy tại: https://neon.tech → Project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/crimsonacademy?sslmode=require"

# --- Gemini AI API Key (REQUIRED for Auto-Generate Exam) ---
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- App URL (tự động điền bởi hosting) ---
APP_URL="http://localhost:3000"

# --- Node Environment ---
NODE_ENV="development"
